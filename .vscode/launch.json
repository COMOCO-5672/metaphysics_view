{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug metaphysics (MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_vscode/bin/metaphysics.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [],
            "externalConsole": false,
            "preLaunchTask": "CMake: Build (VSCode)"
        },
        {
            "name": "Debug metaphysics (Ninja/Single Config)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_vscode/bin/metaphysics.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "MIMode": "gdb",
            "miDebuggerPath": "D:/msys64/mingw64/bin/gdb.exe",
            "externalConsole": false,
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "CMake: Build (VSCode)"
        }
    ]
}
