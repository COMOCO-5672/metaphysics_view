{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug metaphysics (OpenGL/MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_win_gl/bin/Debug/metaphysics.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "environment": [
                {
                    "name": "METAPHYSICS_RENDERER",
                    "value": "opengl"
                },
                {
                    "name": "METAPHYSICS_UI",
                    "value": "imgui"
                }
            ],
            "externalConsole": false,
            "preLaunchTask": "CMake: Build (VSCode)"
        },
        {
            "name": "Debug metaphysics (DX11/MSVC)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build_win_gl/bin/Debug/metaphysics.exe",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false,
            "externalConsole": false,
            "environment": [
                {
                    "name": "METAPHYSICS_RENDERER",
                    "value": "dx11"
                },
                {
                    "name": "METAPHYSICS_UI",
                    "value": "imgui"
                }
            ],
            "preLaunchTask": "CMake: Build (VSCode)"
        }
    ]
}
