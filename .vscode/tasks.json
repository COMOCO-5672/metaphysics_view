{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure (VSCode)",
            "type": "shell",
            "command": "$buildDir = 'build_win_gl'; if (!(Test-Path $buildDir)) { New-Item -ItemType Directory -Path $buildDir | Out-Null }; cmake -S . -B $buildDir -G 'Visual Studio 17 2022' -A x64",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "group": "build",
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        },
        {
            "label": "CMake: Build (VSCode)",
            "type": "shell",
            "command": "$buildDir = 'build_win_gl'; if (!(Test-Path $buildDir)) { throw 'build_win_gl does not exist. Run CMake: Configure first.' }; cmake --build $buildDir --config Debug",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "dependsOn": "CMake: Configure (VSCode)",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$msCompile",
                "$gcc"
            ]
        },
        {
            "label": "CMake: Clean (VSCode)",
            "type": "shell",
            "command": "$buildDir = 'build_win_gl'; if (Test-Path $buildDir) { Remove-Item -LiteralPath $buildDir -Recurse -Force }",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "problemMatcher": []
        },
        {
            "label": "Run: metaphysics (VSCode)",
            "type": "shell",
            "command": "$env:METAPHYSICS_RENDERER = 'opengl'; $env:METAPHYSICS_UI = 'imgui'; $buildDir = 'build_win_gl'; $candidates = @(\"$buildDir\\bin\\Debug\\metaphysics.exe\",\"$buildDir\\bin\\Release\\metaphysics.exe\",\"$buildDir\\bin\\metaphysics.exe\"); $exe = $candidates | Where-Object { Test-Path $_ } | Select-Object -First 1; if (-not $exe) { throw 'metaphysics.exe not found. Run CMake: Build first.' }; & $exe",
            "options": {
                "cwd": "${workspaceFolder}",
                "shell": {
                    "executable": "powershell",
                    "args": [
                        "-NoProfile",
                        "-ExecutionPolicy",
                        "Bypass",
                        "-Command"
                    ]
                }
            },
            "dependsOn": "CMake: Build (VSCode)",
            "problemMatcher": []
        }
    ]
}
